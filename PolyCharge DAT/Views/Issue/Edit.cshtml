@model PolyCharge_DAT.Models.Issue

@{
    ViewData["Title"] = "Edit Issue";
}

<h4>@ViewData["Title"]</h4>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Issue_CreatedBy" class="control-label"></label>
                <input asp-for="Issue_CreatedBy" class="form-control" />
                <span asp-validation-for="Issue_CreatedBy" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Issue_Description" class="control-label"></label>
                <input asp-for="Issue_Description" class="form-control" />
                <span asp-validation-for="Issue_Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Issue_CreatedOn" class="control-label"></label>
                <input asp-for="Issue_CreatedOn" class="form-control" />
                <span asp-validation-for="Issue_CreatedOn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Issue_ClosedBy" class="control-label"></label>
                <input asp-for="Issue_ClosedBy" class="form-control" />
                <span asp-validation-for="Issue_ClosedBy" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Issue_Resolution" class="control-label"></label>
                <input asp-for="Issue_Resolution" class="form-control" />
                <span asp-validation-for="Issue_Resolution" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Issue_ClosedOn" class="control-label"></label>
                <input asp-for="Issue_ClosedOn" class="form-control" />
                <span asp-validation-for="Issue_ClosedOn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Issue_Status" class="control-label"></label>
                <select asp-for="Issue_Status" class="form-control"></select>
                <span asp-validation-for="Issue_Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

