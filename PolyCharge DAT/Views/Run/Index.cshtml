@model IEnumerable<PolyCharge_DAT.Models.Run>

@{
    ViewData["Title"] = "Run Index";
}

<h4>@ViewData["Title"]</h4>

<div class="container">
    <div class="mb-3 mt-3">
        <form method="post" enctype="multipart/form-data" asp-controller="Run" asp-action="Upload">
            <div class="mb-3">
                <label class="form-label">Upload CSV Data File</label>
                <input type="file" name="file" accept=".csv" class="form-control" />
            </div>
            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Upload</button>
            </div>
        </form>
    </div>
</div>

<div class="Container">
    <p>
        <a asp-action="Create">Manually Create New Record</a>
    </p>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Navigation_Options</th>
            <th>
                @Html.DisplayNameFor(model => model.Run_Number)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Customer_Product)
            </th>
            <th>
