@model PolyCharge_DAT.Models.Run

<h4>Post Burn-In Report Create</h4>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Run_Number)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Run_Number)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Customer_Product)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Customer_Product)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Project_Number)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Project_Number)
        </dd>
